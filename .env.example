# Razorpay dashboard → API Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Razorpay dashboard → Settings → Webhooks → secret you set for this endpoint
RAZORPAY_WEBHOOK_SECRET=replace_me

# Graphy dashboard → Integration API (Advanced plan)
GRAPHY_MERCHANT_ID=replace_me
GRAPHY_API_TOKEN=replace_me

# Optional. Defaults to https://api.ongraphy.com
# GRAPHY_API_BASE_URL=https://api.ongraphy.com

# Optional. Defaults to 3000
PORT=3000

# Optional. Browser origin allowed to call POST /api/orders (no CORS headers if unset)
# CORS_ORIGIN=https://checkout.example.com

# Optional paths. Relative paths are resolved from the project root.
# COURSES_PATH=data/courses.json
# ENROLLMENT_STORE_PATH=data/enrollments.json
