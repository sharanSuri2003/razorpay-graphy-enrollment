# Razorpay dashboard → API Keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Razorpay dashboard → Settings → Webhooks → secret you set for this endpoint
RAZORPAY_WEBHOOK_SECRET=replace_me

# Graphy dashboard → Integration API (Advanced plan)
GRAPHY_MERCHANT_ID=replace_me
GRAPHY_API_TOKEN=replace_me

# Optional. Defaults to https://api.ongraphy.com
# GRAPHY_API_BASE_URL=https://api.ongraphy.com

# Graphy retries. Attempts include the first call. Delay doubles after each failure.
# GRAPHY_RETRY_ATTEMPTS=3
# GRAPHY_RETRY_BASE_DELAY_MS=500
# GRAPHY_REQUEST_TIMEOUT_MS=10000

# Optional. Defaults to 3000
PORT=3000

# Optional. Comma-separated browser origins. A request Origin that exactly matches
# one of them is echoed in Access-Control-Allow-Origin. No CORS allow header otherwise.
# CORS_ORIGIN=https://kropiq.in,https://www.kropiq.in

# In-process recovery. Runs at startup and then every interval.
# Set to false when an external cron calls `npm run recover` instead.
# RECOVERY_ENABLED=true
# RECOVERY_INTERVAL_MS=600000
# How far back each run looks, plus a small overlap so a payment on the boundary is seen twice.
# RECOVERY_WINDOW_MS=600000
# RECOVERY_OVERLAP_MS=120000

# Optional paths. Relative paths are resolved from the project root.
# COURSES_PATH=data/courses.json

# WhatsApp purchase confirmation via AiSensy. Sent only after Graphy enrollment succeeds.
# If AISENSY_API_KEY is unset, enrollment still succeeds and no message is sent.
# AISENSY_API_KEY=replace_me
# AISENSY_CAMPAIGN_NAME=kropiq_purchase
# AISENSY_SOURCE=new-landing-page form
# AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
# Guidance video for template parameter 5. A course guideVideoUrl overrides this.
# Leave unset until the video URL is known; the message is skipped without it.
# AISENSY_GUIDE_VIDEO_URL=
